<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="SettingsTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/settings_bg</item>
        <item name="android:statusBarColor">@color/settings_bg</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
    </style>
</resources>
